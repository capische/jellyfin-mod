<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>JellyfinMod</RootNamespace>
    <AssemblyName>JellyfinMod</AssemblyName>
    <Version>0.1.0.0</Version>
  </PropertyGroup>

  <!-- Pinned to the server actually running on the Pi. There is no Jellyfin 11.x: versions ran
       10.x to 10.11, then dropped the leading "10.", so 10.12 became 12.0. Moving to 12.0 / net10
       is a deliberate later step - see ../../jellyfin-web/docs/jellyfinmod/README.md 7.1. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
