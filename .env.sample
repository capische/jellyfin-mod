# TMDB API Read Access Token used by isolated JellyfinMod E2E tests.
# Copy this file to .env and keep the real token local.
TMDB_READ_ACCESS_TOKEN=

# Phase 4 live acceptance only (user decision 3): credentials of the disposable Transmission instance and the
# controlled Torznab fixture. Never production values. Keep .env mode 0600.
JFMOD_TEST_TRANSMISSION_USERNAME=
JFMOD_TEST_TRANSMISSION_PASSWORD=
JFMOD_TEST_TORZNAB_API_KEY=
